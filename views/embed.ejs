(function() {
  var scriptEl = document.currentScript;
  var BASE = scriptEl.src.replace(/\/embed\/.*$/, '');
  var CONTAINER_ID = 'live2d-widget';

  var style = document.createElement('style');
  style.textContent = [
    '#' + CONTAINER_ID + ' { z-index: 9999; pointer-events: none; }',
    '#' + CONTAINER_ID + ' canvas { pointer-events: auto; }',
    '#live2d-close, #live2d-restore, #live2d-random, #live2d-prev, #live2d-next {',
    '  position: fixed; right: 8px;',
    '  width: 22px; height: 22px; padding: 0;',
    '  border: none; border-radius: 50%;',
    '  background: rgba(0,0,0,0.4); color: #fff;',
    '  font-size: 14px; line-height: 22px;',
    '  text-align: center; cursor: pointer; z-index: 9999;',
    '}',
    '#live2d-close, #live2d-restore { bottom: 8px; }',
    '#live2d-random { bottom: 86px; }',
    '#live2d-prev { bottom: 60px; font-size: 10px; }',
    '#live2d-next { bottom: 34px; font-size: 10px; }',
    '#live2d-close:hover, #live2d-restore:hover, #live2d-random:hover, #live2d-prev:hover, #live2d-next:hover { background: rgba(0,0,0,0.7); }'
  ].join('\n');
  document.head.appendChild(style);

  // —— 可选参数（从脚本 URL 的 query 读取）——
  // initial=hidden|shown : 无记忆/未存值时的初始状态（默认 shown，保持原有行为）
  // remember=1          : 记住用户开关状态（localStorage，按浏览器/站点隔离）
  // stateKey=xxx        : 记忆用的 key（默认 live2d-widget-state）
  var params = {};
  (scriptEl.src.split('?')[1] || '').split('&').forEach(function (kv) {
    if (!kv) return;
    var i = kv.indexOf('=');
    if (i < 0) {
      params[decodeURIComponent(kv)] = '1';
    } else {
      params[decodeURIComponent(kv.slice(0, i))] = decodeURIComponent(kv.slice(i + 1));
    }
  });
  var REMEMBER = params.remember && params.remember !== '0' && params.remember !== 'false';
  var STATE_KEY = params.stateKey || 'live2d-widget-state';
  var stateHidden = params.initial === 'hidden';
  if (REMEMBER) {
    try {
      var st = localStorage.getItem(STATE_KEY);
      if (st === 'hidden') stateHidden = true;
      else if (st === 'shown') stateHidden = false;
    } catch (e) {}
  }

  function persistState() {
    if (!REMEMBER) return;
    try {
      localStorage.setItem(STATE_KEY, stateHidden ? 'hidden' : 'shown');
    } catch (e) {}
  }
  function updateButtonsForState() {
    var c = document.getElementById(CONTAINER_ID);
    if (c) c.style.display = stateHidden ? 'none' : '';
    if (closeBtn) closeBtn.style.display = stateHidden ? 'none' : '';
    if (restoreBtn) restoreBtn.style.display = stateHidden ? '' : 'none';
    if (randomBtn) randomBtn.style.display = stateHidden ? 'none' : '';
    if (prevBtn) prevBtn.style.display = stateHidden ? 'none' : '';
    if (nextBtn) nextBtn.style.display = stateHidden ? 'none' : '';
  }

  var showControls = <%- controls %>;
  var currentCharName = '<%- name %>';
  var characters = [];
  // —— 记忆上次选中的角色：
  // 切角色时写入 localStorage（按浏览器/站点隔离），加载后等列表与播放器就绪再恢复。
  var savedCharName = null;
  var wantRestore = false;
  var playerReady = false;
  try {
    savedCharName = localStorage.getItem('live2d-character');
  } catch (e) {}
  if (savedCharName && savedCharName !== currentCharName) wantRestore = true;
  var closeBtn, restoreBtn, randomBtn, prevBtn, nextBtn;

  if (showControls) {
    closeBtn = document.createElement('button');
    closeBtn.id = 'live2d-close';
    closeBtn.textContent = '×';
    closeBtn.title = '关闭看板娘';
    closeBtn.onclick = function() {
      stateHidden = true;
      persistState();
      updateButtonsForState();
    };
    document.body.appendChild(closeBtn);

    restoreBtn = document.createElement('button');
    restoreBtn.id = 'live2d-restore';
    restoreBtn.textContent = '○';
    restoreBtn.title = '显示看板娘';
    restoreBtn.style.display = 'none';
    restoreBtn.onclick = function() {
      stateHidden = false;
      persistState();
      updateButtonsForState();
    };
    document.body.appendChild(restoreBtn);

    // 按钮已建好，按初始/记忆状态套用一次
    updateButtonsForState();
  }

  function findCurrentIndex() {
    for (var i = 0; i < characters.length; i++) {
      if (characters[i].name === currentCharName) return i;
    }
    return -1;
  }

  function switchToCharacter(target) {
    if (!window.Live2DPlayer || !window.Live2DPlayer.switchCharacter) return;
    window.Live2DPlayer.switchCharacter(BASE + target.skel, BASE + target.atlas);
    currentCharName = target.name;
    try {
      localStorage.setItem('live2d-character', target.name);
    } catch (e) {}
  }

  // 等角色列表与播放器都就绪后，恢复上次选中的角色（只执行一次）
  function maybeRestoreCharacter() {
    if (!wantRestore || !playerReady) return;
    if (characters.length === 0) return;
    for (var i = 0; i < characters.length; i++) {
      if (characters[i].name === savedCharName) {
        wantRestore = false;
        switchToCharacter(characters[i]);
        return;
      }
    }
    // 记忆的角色已不在列表中：清掉记忆，保持默认
    wantRestore = false;
    try {
      localStorage.removeItem('live2d-character');
    } catch (e) {}
  }

  function renderSwitchButtons() {
    if (characters.length <= 1) return;

    randomBtn = document.createElement('button');
    randomBtn.id = 'live2d-random';
    randomBtn.textContent = '⟳';
    randomBtn.title = '随机角色';
    randomBtn.onclick = function() {
      var others = characters.filter(function(c) { return c.name !== currentCharName; });
      if (others.length === 0) return;
      var target = others[Math.floor(Math.random() * others.length)];
      switchToCharacter(target);
    };
    document.body.appendChild(randomBtn);

    prevBtn = document.createElement('button');
    prevBtn.id = 'live2d-prev';
    prevBtn.textContent = '◀';
    prevBtn.title = '上一个角色';
    prevBtn.onclick = function() {
      var idx = findCurrentIndex();
      if (idx < 0) return;
      var prevIdx = idx <= 0 ? characters.length - 1 : idx - 1;
      switchToCharacter(characters[prevIdx]);
    };
    document.body.appendChild(prevBtn);

    nextBtn = document.createElement('button');
    nextBtn.id = 'live2d-next';
    nextBtn.textContent = '▶';
    nextBtn.title = '下一个角色';
    nextBtn.onclick = function() {
      var idx = findCurrentIndex();
      if (idx < 0) return;
      var nextIdx = idx >= characters.length - 1 ? 0 : idx + 1;
      switchToCharacter(characters[nextIdx]);
    };
    document.body.appendChild(nextBtn);

    // 切换按钮属异步插入，按当前状态补一次显隐
    updateButtonsForState();
  }

  function loadCharacterList() {
    fetch(BASE + '/api/characters')
      .then(function(r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function(list) {
        characters = list;
        renderSwitchButtons();
        maybeRestoreCharacter();
      })
      .catch(function(err) {
        console.warn('Live2D embed: failed to load character list', err);
      });
  }

  var targetHeight = <%- targetHeight %>;
  if (!targetHeight) {
    targetHeight = window.innerWidth < 768 ? 250 : 400;
  }

  var rightOffsetExtra = <%- typeof rightOffset !== 'undefined' ? rightOffset : 0 %>;
  var bottomOffsetExtra = <%- typeof bottomOffset !== 'undefined' ? bottomOffset : 0 %>;

  function onSize(width, height) {
    var container = document.getElementById(CONTAINER_ID);
    if (!container) return;
    var scale = targetHeight / height;
    var w = Math.round(width * scale);
    var h = Math.round(height * scale);
    container.style.width = w + 'px';
    container.style.height = h + 'px';
    container.style.right = Math.round(80 + rightOffsetExtra - w / 2) + 'px';
    container.style.bottom = Math.round(140 + bottomOffsetExtra - h / 2) + 'px';
  }

  window.addEventListener('message', function(e) {
    var d = e.data || {};
    if (d.type === 'size' && d.width && d.height) {
      onSize(d.width, d.height);
    }
  });

  function initPlayer() {
    var container = document.getElementById(CONTAINER_ID);
    if (!container) {
      console.error('Live2D embed: container #' + CONTAINER_ID + ' not found');
      return;
    }

    container.dataset.skels = '<%- skel %>';
    container.dataset.atlas = '<%- atlas %>';
    container.dataset.animation = '<%- defaultAnim %>';
    container.dataset.loop = '<%- loop %>';
    container.dataset.touch = '<%- touchAnim %>';
    container.dataset.viewport = 'centered';
    container.dataset.sendSize = 'true';

    <%- playerCoreJs %>

    // 播放器就绪后再尝试恢复上次角色；角色列表若稍后才到，会在加载成功后补一次
    if (window.Live2DPlayer && window.Live2DPlayer.on) {
      window.Live2DPlayer.on('onReady', function() {
        playerReady = true;
        maybeRestoreCharacter();
      });
    }
  }

  if (window.spine) {
    initPlayer();
  } else {
    var s = document.createElement('script');
    s.src = BASE + '/public/spine-player/spine-player.js';
    s.onload = initPlayer;
    s.onerror = function() {
      console.error('Live2D embed: failed to load spine-player.js');
    };
    document.head.appendChild(s);
  }

  // Start loading character list in parallel (does not block player init)
  if (showControls) {
    loadCharacterList();
  }
})();
